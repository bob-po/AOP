# AOP single-node cloud deploy
# Copy to .env and edit AOP_PUBLIC_HOST before: ./deploy.sh up

# Public hostname or IP of this server (browser-reachable)
AOP_PUBLIC_HOST=127.0.0.1
AOP_PUBLIC_SCHEME=http

# Phase 15: auth on by default for deploy / public hosts
AUTH_REQUIRED=true
# Seed the well-known local-dev key (prefix logged only). Set false after rotating keys.
SEED_DEV_KEY=true

# Console + register-agents use this key (rotate in production)
NEXT_PUBLIC_API_KEY=aop_sk_dev_local_0000000000000001
GATEWAY_API_KEY=aop_sk_dev_local_0000000000000001

# Optional mirrors (China-friendly defaults used in Dockerfiles)
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
