# DeepPresenter configuration for AOP (copy to config.yaml)
# Upstream: https://github.com/icip-cas/PPTAgent/tree/v1.1.38
#
# Prefer the same OpenAI-compatible endpoint you use for DeerFlow / DeepSeek.
# Replace api_key values (do not commit real secrets).

context_folding: true
offline_mode: false
async_tool_mode: false

research_agent:
  base_url: "https://api.deepseek.com"
  model: "deepseek-chat"
  api_key: "YOUR_KEY"

design_agent:
  base_url: "https://api.deepseek.com"
  model: "deepseek-chat"
  api_key: "YOUR_KEY"

long_context_model:
  base_url: "https://api.deepseek.com"
  model: "deepseek-chat"
  api_key: "YOUR_KEY"
