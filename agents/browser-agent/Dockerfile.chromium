# Chromium-enabled Browser Agent (Phase 29)
# Build: docker build -f Dockerfile.chromium -t aop-browser-chromium .
FROM mcr.microsoft.com/playwright/python:v1.49.1-jammy

WORKDIR /app

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin aop \
 && mkdir -p /tmp/aop && chown -R aop:aop /tmp/aop /app

COPY requirements-playwright.txt .
RUN pip install --no-cache-dir -r requirements-playwright.txt \
 && playwright install chromium

COPY agent-card.json .
COPY browse.py .
COPY agent.py .

ENV PORT=8008
ENV AGENT_URL=http://0.0.0.0:8008/
ENV AOP_SECCOMP_PROFILE=browser-agent
ENV BROWSER_MODE=playwright
ENV BROWSER_TIMEOUT_MS=15000
ENV HOME=/tmp/aop
ENV PYTHONDONTWRITEBYTECODE=1

USER 10001:10001
EXPOSE 8008

CMD ["uvicorn", "agent:app", "--host", "0.0.0.0", "--port", "8008"]
