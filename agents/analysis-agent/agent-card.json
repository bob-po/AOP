{
  "name": "Analysis Agent",
  "description": "Business analysis over research and knowledge inputs for AOP Task DAGs.",
  "url": "http://127.0.0.1:8004/",
  "version": "0.2.0",
  "protocolVersion": "0.3.0",
  "agentId": "aop-analysis-agent-v1",
  "agentKey": "analysis-agent",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false
  },
  "defaultInputModes": ["text"],
  "defaultOutputModes": ["text", "application/json"],
  "skills": [
    {
      "id": "business-analysis",
      "name": "Business Analysis",
      "description": "Synthesize research into structured business insights",
      "tags": ["analysis", "business"],
      "examples": ["Analyze market trends for AI agents", "Evaluate competitive landscape"],
      "inputModes": ["text"],
      "outputModes": ["text", "application/json"],
      "requiresApproval": false
    },
    {
      "id": "summarization",
      "name": "Multi-Document Summarization",
      "description": "Summarize multiple research documents into coherent insights",
      "tags": ["analysis", "summarization"],
      "examples": ["Summarize Q1 and Q2 reports", "Combine research from multiple sources"],
      "inputModes": ["text"],
      "outputModes": ["text", "application/json"],
      "requiresApproval": false
    },
    {
      "id": "comparison",
      "name": "Comparative Analysis",
      "description": "Compare and contrast different documents or datasets",
      "tags": ["analysis", "comparison"],
      "examples": ["Compare two product features", "Compare pricing strategies"],
      "inputModes": ["text"],
      "outputModes": ["text", "application/json"],
      "requiresApproval": false
    },
    {
      "id": "analysis",
      "name": "General Analysis",
      "description": "Perform general analysis on provided content",
      "tags": ["analysis"],
      "examples": ["Analyze the provided text", "Extract key insights from data"],
      "inputModes": ["text"],
      "outputModes": ["text", "application/json"],
      "requiresApproval": false
    }
  ],
  "runtime": {
    "framework": "fastapi",
    "pythonVersion": "3.8+",
    "timeoutSeconds": 60,
    "startupTimeoutSeconds": 30
  },
  "resources": {
    "cpuCores": 1.0,
    "memoryMb": 512
  },
  "metadata": {
    "author": "AOP Platform",
    "license": "MIT",
    "repository": "https://github.com/aop-platform/agents",
    "tags": ["analysis", "business", "reference"],
    "categories": ["data-analysis"]
  }
}
