# Model provider API keys (Pi ModelRuntime also reads these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GOOGLE_API_KEY=

# DeepSeek example (OpenAI-compatible):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-pro
# DEPLOYPILOT_MODEL=deepseek/deepseek-v4-pro

# Optional defaults
DEPLOYPILOT_MODEL=deepseek/deepseek-v4-pro
DEPLOYPILOT_MODE=docker
DEPLOYPILOT_MAX_REPAIR=3
DEPLOYPILOT_MEMORY_LIMIT=512m
DEPLOYPILOT_CPU_LIMIT=1.0
