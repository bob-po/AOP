# Copy to .env (gitignored) and fill in secrets.
# Loaded automatically by agents/harness-agent/agent.py

# Required for deepseek-harness (SDK / dsh / tool_loop)
DEEPSEEK_API_KEY=

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DSH_HOME=C:\Users\<you>\.aop\dsh-home
# OPENAI_API_KEY=
# PI_PROVIDER=deepseek
# PI_MODEL=deepseek-flash
# Per-process listen URL (set automatically from PORT in agent.py).
# Do not leave AGENT_URL pointing at another agent in the parent shell.
# AGENT_URL=http://127.0.0.1:8011/
# CLI wall-clock limits (seconds). Research / multi-agent goals often need >15m.
# CLAUDE_CLI_TIMEOUT_S=1800
# DSH_CLI_TIMEOUT_S=1800
# PI_CLI_TIMEOUT_S=1800
